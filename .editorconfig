# https://editorconfig.org, read by ktlint (quintkonnect.ktlint convention plugin) and IntelliJ:
# https://pinterest.github.io/ktlint/latest/rules/configuration-ktlint/
#
# After editing this file, run `./gradlew --stop`, then `./gradlew spotlessApply --rerun-tasks`.
# ktlint keeps parsed .editorconfig files in a static cache that lives as long as the Gradle daemon,
# so a Spotless run in the same daemon still applies the old settings, and a later run in a new
# daemon reuses that run's result as up to date.
root = true

[*.{kt,kts}]
# The Kotlin coding conventions IntelliJ formats to, which this code was written in; ktlint's own
# default (ktlint_official) would rewrite most function signatures and wrapped expressions.
ktlint_code_style = intellij_idea
# With no max_line_length set, this rule joins every expression body that starts on the line after
# its signature back onto it, however long the result; this code wraps them on purpose.
ktlint_standard_function-signature = disabled
